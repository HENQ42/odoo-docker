<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="helpdesk_ticket_view_form_zabbix" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.zabbix</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Zabbix" name="zabbix_info">
                    <group>
                        <field name="x_zbx_event_id" readonly="1"/>
                        <field name="x_zbx_trigger_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="x_zbx_host" readonly="1"/>
                        <field name="x_zbx_severity" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="helpdesk_ticket_view_search_zabbix" model="ir.ui.view">
        <field name="name">helpdesk.ticket.search.zabbix</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.helpdesk_ticket_view_search"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="x_zbx_event_id"/>
                <field name="x_zbx_host"/>
            </field>
        </field>
    </record>

</odoo>
